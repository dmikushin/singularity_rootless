Bootstrap: docker
From: rockylinux:8

%files
    ./fakechown.c /fakechown.c

%post
    dnf install -y findutils
    find /usr -type d -exec chmod +w {} \;
    find /usr/lib/python3.6/site-packages/dnf/cli/commands -type f -name "*.py" -exec sed -i 's/root_user = True/root_user = False/g' {} \;

    dnf install -y epel-release

    dnf install -y vim mc glibc-langpack-en git gcc zlib-devel make
    gcc -O3 -g -shared -fPIC -o /usr/lib/libfakechown.so /fakechown.c -ldl
    rm /fakechown.c
    
    git clone https://github.com/dmikushin/fake-sudo.git
    cp /fake-sudo/ark/fake-sudo.sh /usr/bin/fake-sudo
    rm -rf fake-sudo
    chmod +x /usr/bin/fake-sudo
    bash -c 'echo -e "#!/bin/bash\nLD_PRELOAD=/usr/lib/libfakechown.so /usr/bin/fake-sudo \"\$@\"" >/usr/bin/sudo'
    chmod +x /usr/bin/sudo

    dnf install -y fish
    bash -c 'echo -e "# /etc/shells: always use fish as a login shell\n/usr/bin/fish\n/bin/bash" >/etc/shells'

    git clone https://github.com/dmikushin/dropbear.git
    cd dropbear
    mkdir build
    cd build
    ../configure
    make
    sudo make install
    cd ../..
    rm -rf dropbear
    mkdir -p /etc/dropbear

%startscript
    sudo /usr/local/sbin/dropbear -w -s -e -R -E -p ${1:-22221}

%environment
    export SINGULARITY_SHELL=/usr/bin/fish
